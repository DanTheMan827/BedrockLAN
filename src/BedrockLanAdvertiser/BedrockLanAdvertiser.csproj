<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>BedrockLanAdvertiser</RootNamespace>
    <!-- WebRTC transfer server (needed for authenticated NetherNet servers). Disable with: dotnet build -p:EnableWebRtc=false -->
    <EnableWebRtc Condition="'$(EnableWebRtc)' == ''">true</EnableWebRtc>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableWebRtc)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_WEBRTC</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BedrockLan\BedrockLan.csproj" />
    <!-- Licenses of the open-source components, printed by the "licenses" option. -->
    <ProjectReference Include="..\BedrockLan.Licenses\BedrockLan.Licenses.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableWebRtc)' == 'true'">
    <ProjectReference Include="..\BedrockLan.WebRtc\BedrockLan.WebRtc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="servers.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
