// Bedrock LAN transfer protocol: the packets the minimal transfer server sends and the conversation it holds
// with a client, from the first packet to the Transfer. Built into the library as the default; a newer copy can
// be loaded at run time (ProtocolConfig.Parse) to follow game updates without a new build.
//
// GENERATED by tools/ProtocolGen from the C# definitions in src/BedrockLan.Protocol.Definitions. Change those
// instead: building BedrockLan regenerates this file, and the publish workflow hosts the same output.
//
// Format (formatVersion 1). JSON with // and /* */ comments and trailing commas allowed.
//
// packets.<Name> = { "id": <packet id>, "body": [ <field>, ... ] }
//   A field is an object with exactly one type key, holding its value, plus optional modifiers:
//     { "<Type>": <value>, "since": <protocol>, "until": <protocol>, "optional": true, "count": "<Type>" }
//   "since" is inclusive (protocol >= since); "until" is exclusive (protocol < until). A field without either is
//   always written. Protocols newer than any cut-off get the newest layout.
//   Primitive types: Byte, Bool, Int16LE, UInt16LE, Int32LE, Int32BE, UInt32LE, Int64LE, UInt64LE, FloatLE,
//          VarInt32, VarUInt32, VarInt64, VarUInt64 (zig-zag for the signed ones), String (VarUInt32 length +
//          UTF-8), Bytes (hex, spaces allowed), NetworkNbt (a tag tree: { "compound": { ... } }).
//   Declared types: any type in "types" (Vec3, LevelSettings, ...). Its value is an object of its fields
//          ({ "Vec3": { "x": 0, "y": 100, "z": 0 } }), an array of them in order ({ "Vec3": [0, 100, 0] }),
//          or, for a one-field type, just that value.
//   Array<Type>: a count, then the items. The count is a VarUInt32 unless the field says "count": "UInt32LE"
//          (Mojang's docs: "No size compression"), UInt16LE, Byte, ...
//   "optional": true marks a field [OPT] as in Mojang's docs: a presence bool, then the value if present.
//          null means absent.
//   Values: a literal, or a variable: "$name". Use "$$" to start a literal string with "$".
//     $protocol         the client's protocol version
//     $target.host      where the client is being sent ($target.port: its port)
//     $worldName        TransferOptions.LoadingWorldName
//     $offlineMessage   TransferOptions.OfflineMessage
//     $spawnTimeout     TransferOptions.SpawnTimeout, in seconds
//     $uuid.random      a new random UUID string each time it's written
//     $timing           TransferOptions.Timing: "Immediate", "AfterResourcePacks" or "AfterSpawn"
//     plus any variable a stage's "read" stores (e.g. $radius).
//
// types.<Name> = [ { "<Type>": "fieldName" }, ... ]  A type made of fields, written in order. Fields take the
//   same modifiers as packet fields and can use other declared types. A name may appear twice when the two
//   fields' protocol ranges don't overlap (a field whose type changed in some version).
//
// session = { "start": <stage>, "transferPacket": <packet>, "offlinePacket": <packet>,
//             "compressionHeaderSince": <protocol>, "stages": { <name>: <stage>, ... } }
//   A stage waits for one client packet:
//     "expect": { "packet": <id>, "read": [ <read field>, ... ] }
//   Its read fields are read in order from the packet body:
//     { "<Type>": "$var" }                  store the value (types: Byte, Bool, UInt16LE, Int32LE, Int32BE,
//                                           UInt32LE, VarInt32, VarUInt32, String)
//     { "<Type>": "$var", "keep": true }    store it only if the variable has no value yet
//     { "<Type>": "$var", "clamp": [1, 8] } store it clamped to [min, max]
//     { "<Type>": 4 } or { "<Type>": [1, 3] } the value must be one of these, or the packet is ignored
//   Other packets, and packets whose read doesn't match, are ignored; the stage keeps waiting.
//   Then its "steps" run in order. Each step may have:
//     "if": <condition>           skip the step unless it holds
//     "log": "text"               debug log line
//     "send": [ "Packet", ... ]   send packets (each in its own batch)
//     "compression": true         compress every batch from now on (after this step's sends)
//   and at most one ending, which stops the steps:
//     "goto": "<stage>"           wait in that stage next
//     "transfer": true            send transferPacket (offlinePacket if the destination is offline), then close
//     "close": true               close without sending anything
//   Steps that end without an ending leave the session waiting in the same stage.
//   "timeout": { "seconds": <number or $var>, "steps": [ ... ] } runs those steps if the stage is still waiting
//   after that long.
//   Conditions: { "timing": "AfterSpawn" | [..] }, { "protocol": { "min": n, "max": n } } (both inclusive),
//   { "targetOnline": true|false }, { "variable": { "$name": value | [..] } } (the variable is one of them),
//   { "any": [..] }, { "all": [..] }, { "not": {..} }.
{
  "formatVersion": 1,
  "configVersion": "2026-11-05.6",

  // Types used by the packets, named and laid out as in Mojang's bedrock-protocol-docs.
  "types": {
    // A pack's UUID and version.
    "PackIdVersion": [
      { "UUID": "packUUID" },
      { "PackVersion": "packVersion" },
    ],
    // mce::UUID: the most significant 64 bits, then the least significant.
    "UUID": [
      { "UInt64LE": "mostSignificantBits" },
      { "UInt64LE": "leastSignificantBits" },
    ],
    // A pack's version.
    "PackVersion": [
      { "String": "version" },
    ],
    // A resource pack offered in ResourcePacksInfo.
    "PackInfoData": [
      { "PackIdVersion": "packIdVersion" },
      { "UInt64LE": "packSize" },
      { "String": "contentKey" },
      { "String": "subpackName" },
      { "ContentIdentity": "contentIdentity" },
      { "Bool": "hasScripts" },
      { "Bool": "isAddonPack" },
      { "Bool": "isRayTracingCapable" },
      { "String": "cdnUrl" },
    ],
    // A pack's content identity.
    "ContentIdentity": [
      { "String": "identity" },
    ],
    // A pack's CDN address (ResourcePacksInfo before 748).
    "PackCdnUrl": [
      { "String": "packId" },
      { "String": "cdnUrl" },
    ],
    // A pack in ResourcePackStack.
    "PackInstanceId": [
      { "String": "packId" },
      { "String": "version" },
      { "String": "subPackName" },
    ],
    // Experiments: the toggles (count without size compression) and whether any was ever toggled.
    "Experiments": [
      { "Array<ExperimentToggle>": "toggles", "count": "UInt32LE" },
      { "Bool": "experimentsEverToggled" },
    ],
    // One experiment and whether it's on.
    "ExperimentToggle": [
      { "String": "name" },
      { "Bool": "enabled" },
    ],
    // VoxelShapes::SerializableVoxelShape: a custom collision / selection shape.
    "SerializableVoxelShape": [
      { "SerializableCells": "cells" },
      { "Array<FloatLE>": "xCoordinates" },
      { "Array<FloatLE>": "yCoordinates" },
      { "Array<FloatLE>": "zCoordinates" },
    ],
    // VoxelShapes::SerializableCells: a shape's cell grid.
    "SerializableCells": [
      { "Byte": "xSize" },
      { "Byte": "ySize" },
      { "Byte": "zSize" },
      { "Array<Byte>": "storage" },
    ],
    // A voxel shape name and its registry handle.
    "VoxelShapeName": [
      { "String": "key" }, // hashed_string
      { "UInt16LE": "value" }, // VoxelShapes::RegistryHandle
    ],
    // ActorUniqueID: an entity's unique id.
    "ActorUniqueID": [
      { "VarInt64": "id" },
    ],
    // ActorRuntimeID: an entity's runtime id.
    "ActorRuntimeID": [
      { "VarUInt64": "id" },
    ],
    // Vec3: three floats.
    "Vec3": [
      { "FloatLE": "x" },
      { "FloatLE": "y" },
      { "FloatLE": "z" },
    ],
    // Vec2: two floats.
    "Vec2": [
      { "FloatLE": "x" },
      { "FloatLE": "y" },
    ],
    // LevelSettings: the world's settings.
    "LevelSettings": [
      { "UInt64LE": "seed" },
      { "SpawnSettings": "spawnSettings" },
      { "VarInt32": "generatorType" }, // GeneratorType: 2 flat
      { "VarInt32": "gameType" }, // GameType: 2 adventure
      { "Bool": "isHardcore" },
      { "VarInt32": "gameDifficulty" }, // Difficulty: 1 easy
      { "BlockPos": "defaultSpawnBlockPosition" },
      { "Bool": "achievementsDisabled" },
      { "VarInt32": "editorWorldType" },
      { "Bool": "isCreatedInEditor" },
      { "Bool": "isExportedFromEditor" },
      { "Byte": "editorLevelMigrationVersion", "since": 2216 }, // EditorLevelMigrationVersion: 0 legacy
      { "VarInt32": "dayCycleStopTime" },
      { "VarUInt32": "educationEditionOffer" },
      { "Bool": "educationFeaturesEnabled" },
      { "String": "educationProductId" },
      { "FloatLE": "rainLevel" },
      { "FloatLE": "lightningLevel" },
      { "Bool": "hasConfirmedPlatformLockedContent" },
      { "Bool": "multiplayerGameIntent" },
      { "Bool": "lanBroadcastIntent" },
      { "VarInt32": "xboxLiveBroadcastSetting" },
      { "VarInt32": "platformBroadcastSetting" },
      { "Bool": "commandsEnabled" },
      { "Bool": "texturePacksRequired" },
      { "GameRulesChangedPacketData": "ruleData" },
      { "Experiments": "experiments" },
      { "Bool": "hasBonusChestEnabled" },
      { "Bool": "startWithMapEnabled" },
      { "Byte": "playerPermissions" }, // PlayerPermissionLevel: 1 member
      { "Int32LE": "serverChunkTickRange" },
      { "Bool": "hasLockedBehaviorPack" },
      { "Bool": "hasLockedResourcePack" },
      { "Bool": "isFromLockedTemplate" },
      { "Bool": "useMsaGamertagsOnly" },
      { "Bool": "isFromWorldTemplate" },
      { "Bool": "isWorldTemplateOptionLocked" },
      { "Bool": "onlySpawnV1Villagers" },
      { "Bool": "personaDisabled" },
      { "Bool": "customSkinsDisabled" },
      { "Bool": "emoteChatMuted" },
      { "String": "baseGameVersion" },
      { "Int32LE": "limitedWorldWidth" },
      { "Int32LE": "limitedWorldDepth" },
      { "Bool": "netherType" }, // new nether
      { "EduSharedUriResource": "eduSharedUriResource" },
      { "Bool": "overrideForceExperimentalGameplay", "optional": true },
      { "Byte": "chatRestrictionLevel" },
      { "Bool": "disablePlayerInteractions" },
      { "VarInt32": "serverEditorConnectionPolicy" },
      { "Bool": "allowAnonymousBlockDropsInEditorWorlds" },
    ],
    // SpawnSettings: biome and dimension the player spawns in.
    "SpawnSettings": [
      { "Int16LE": "spawnBiomeType" }, // SpawnBiomeType enum: 0 default
      { "String": "userDefinedBiomeName" },
      { "VarInt32": "dimension" }, // 0 overworld
    ],
    // A block position as StartGame's level settings use it: three zig-zag varints.
    "BlockPos": [
      { "VarInt32": "x" },
      { "VarInt32": "y" },
      { "VarInt32": "z" },
    ],
    // GameRulesChangedPacketData: the game rules.
    "GameRulesChangedPacketData": [
      { "Array<GameRule>": "rulesList" },
    ],
    // GameRule. Only boolean rules can be described: the value is a union (bool, int or float) chosen by its type id.
    "GameRule": [
      { "String": "ruleName" },
      { "Bool": "ruleCanBeModified" },
      { "VarUInt32": "ruleValueType" }, // value type: 1 bool
      { "Bool": "ruleValue" },
    ],
    // EduSharedUriResource: an education edition link button.
    "EduSharedUriResource": [
      { "String": "buttonName" },
      { "String": "linkUri" },
    ],
    // SyncedPlayerMovementSettings: how movement is synchronised.
    "SyncedPlayerMovementSettings": [
      { "VarInt32": "rewindHistorySize" },
      { "Bool": "serverAuthoritativeBlockBreaking" },
    ],
    // ServerBlockProperty: a custom block's name and definition.
    "ServerBlockProperty": [
      { "String": "blockName" },
      { "NetworkNbt": "blockDefinition" }, // map of block states (can be left empty)
    ],
    // NetworkPermissions: what the server is authoritative for.
    "NetworkPermissions": [
      { "Bool": "serverAuthSoundEnabled" },
    ],
    // server_config: server configuration join info.
    "ServerConfig": [
      { "GatheringsConfig": "gathering", "optional": true },
      { "ClientStoreEntryPoint": "clientStoreEntryPoint", "optional": true },
      { "Presence": "presence", "optional": true },
      { "ManagedChat": "managedChat", "since": 2235, "optional": true },
    ],
    // gatheringsConfig: the experience a player joins through. Every field became optional in 2192.
    "GatheringsConfig": [
      { "UUID": "experienceId", "until": 2192 },
      { "UUID": "experienceId", "since": 2192, "optional": true },
      { "String": "experienceName", "until": 2192 },
      { "String": "experienceName", "since": 2192, "optional": true },
      { "UUID": "worldId", "until": 2192 },
      { "UUID": "worldId", "since": 2192, "optional": true },
      { "String": "worldName", "until": 2192 },
      { "String": "worldName", "since": 2192, "optional": true },
      { "String": "creatorId", "until": 2192 },
      { "String": "creatorId", "since": 2192, "optional": true },
      { "UUID": "targetId", "until": 2192 },
      { "UUID": "targetId", "since": 2192, "optional": true },
      { "String": "scenarioId", "until": 2192 },
      { "String": "scenarioId", "since": 2192, "optional": true },
      { "String": "serverId", "until": 2192 },
      { "String": "serverId", "since": 2192, "optional": true },
    ],
    // A store entry point for the client's store button.
    "ClientStoreEntryPoint": [
      { "String": "storeId" },
      { "String": "storeName" },
    ],
    // Rich presence for the join.
    "Presence": [
      { "String": "richPresenceId", "optional": true },
    ],
    // Managed chat settings.
    "ManagedChat": [
      { "Bool": "enabled", "optional": true },
    ],
    // ServerTelemetryData: ids for the client's telemetry.
    "ServerTelemetryData": [
      { "String": "serverId" },
      { "String": "scenarioId" },
      { "String": "worldId" },
      { "String": "ownerId" },
    ],
    // An item in the item registry.
    "ItemData": [
      { "String": "itemName" },
      { "Int16LE": "itemId" },
      { "Bool": "isComponentBased" },
      { "VarInt32": "itemVersion" },
      { "NetworkNbt": "itemComponentData" },
    ],
    // A creative inventory group.
    "CreativeGroupInfo": [
      { "Byte": "creativeCategory" }, // CreativeItemCategory
      { "String": "name" },
      { "NetworkItemInstanceDescriptor": "groupIconItem" },
    ],
    // NetworkItemInstanceDescriptor: an item stack.
    "NetworkItemInstanceDescriptor": [
      { "VarInt32": "id" },
      { "UInt16LE": "stackSize" },
      { "VarUInt32": "auxValue" },
      { "VarInt32": "blockRuntimeId" },
      { "String": "userDataBuffer" },
    ],
    // A creative inventory item.
    "CreativeItemEntry": [
      { "VarUInt32": "creativeNetId" },
      { "NetworkItemInstanceDescriptor": "itemInstance" },
      { "VarUInt32": "groupIndex" },
    ],
    // TransferPlayerUIOptions: what the client shows while it transfers.
    "TransferPlayerUIOptions": [
      { "String": "titleText", "optional": true },
      { "String": "bodyText", "optional": true },
      { "Bool": "titleVisible", "optional": true },
      { "Bool": "bodyVisible", "optional": true },
      { "String": "cancelButtonText", "optional": true },
      { "Bool": "cancelButtonVisible", "optional": true },
      { "FloatLE": "cancelButtonDelaySeconds", "optional": true },
    ],
    // DisconnectPacketMessages: the message and its filtered copy.
    "DisconnectPacketMessages": [
      { "String": "message" },
      { "String": "filteredMessage", "since": 712 },
    ],
  },

  "packets": {
    // NetworkSettings: compress batches over 256 bytes with zlib.
    "NetworkSettings": {
      "id": 143,
      "body": [
        { "UInt16LE": 256 }, // compression threshold
        { "UInt16LE": 0 }, // compression algorithm: ZLib (flate)
        { "Bool": false }, // client throttle enabled
        { "Byte": 0 }, // client throttle threshold
        { "FloatLE": 0 }, // client throttle scalar
      ],
    },
    "PlayStatusLoginSuccess": {
      "id": 2,
      "body": [
        { "Int32BE": 0 }, // status: 0 login success, 3 player spawn
      ],
    },
    "PlayStatusPlayerSpawn": {
      "id": 2,
      "body": [
        { "Int32BE": 3 }, // status: 0 login success, 3 player spawn
      ],
    },
    // An empty ResourcePacksInfo: no behaviour or resource packs.
    "ResourcePacksInfo": {
      "id": 6,
      "body": [
        { "Bool": false }, // resource pack required
        { "Bool": false }, // has addon packs
        { "Bool": false }, // has scripts
        { "Bool": false, "since": 818 }, // force disable vibrant visuals
        { "PackIdVersion": {
          "packUUID": { "mostSignificantBits": 0, "leastSignificantBits": 0 },
          "packVersion": { "version": "" },
        }, "since": 766 }, // world template id and version
        { "Array<PackInfoData>": [], "since": 2168 }, // resource packs
        { "Array<PackInfoData>": [], "until": 2168, "count": "UInt16LE" }, // resource packs (older layout: count is a UInt16LE; only ever empty here)
        { "Array<PackCdnUrl>": [], "until": 748 }, // CDN URLs (before 748)
      ],
    },
    // An empty ResourcePackStack.
    "ResourcePackStack": {
      "id": 7,
      "body": [
        { "Bool": false }, // texture pack required
        { "Array<PackInstanceId>": [], "until": 898 }, // behaviour packs (before 898)
        { "Array<PackInstanceId>": [] }, // resource packs
        { "String": "*" }, // base game version
        { "Experiments": { "toggles": [], "experimentsEverToggled": false } }, // experiments
        { "Bool": false, "until": 2239 }, // include editor packs
        { "Byte": 0, "since": 2239 }, // editor pack types: 0 none
      ],
    },
    // JigsawStructureData with the four empty lists vanilla sends.
    "JigsawStructureData": {
      "id": 313,
      "body": [
        { "NetworkNbt": { "compound": { "processors": { "list": { "of": "compound", "items": [] } }, "template_pools": { "list": { "of": "compound", "items": [] } }, "jigsaws": { "list": { "of": "compound", "items": [] } }, "structure_sets": { "list": { "of": "compound", "items": [] } } } } }, // jigsaw structure rules
      ],
    },
    // No custom voxel shapes.
    "VoxelShapes": {
      "id": 337,
      "body": [
        { "Array<SerializableVoxelShape>": [] }, // shapes
        { "Array<VoxelShapeName>": [] }, // name map
        { "UInt16LE": 0 }, // custom shape count
      ],
    },
    // A minimal StartGame: empty world, player floating at y=100 in adventure mode. Checked against Mojang's
    // docs for 2168-2250; the only wire change in that range is the migration version byte from 2216.
    "StartGame": {
      "id": 11,
      "body": [
        { "ActorUniqueID": { "id": 1 } }, // entity id
        { "ActorRuntimeID": { "id": 1 } }, // runtime id
        { "VarInt32": 2 }, // player game type: 2 adventure
        { "Vec3": { "x": 0, "y": 100, "z": 0 } }, // position
        { "Vec2": { "x": 0, "y": 0 } }, // rotation (pitch, yaw)
        { "LevelSettings": {
          "seed": 0,
          "spawnSettings": {
            "spawnBiomeType": 0, // SpawnBiomeType enum: 0 default
            "userDefinedBiomeName": "",
            "dimension": 0, // 0 overworld
          },
          "generatorType": 2, // GeneratorType: 2 flat
          "gameType": 2, // GameType: 2 adventure
          "isHardcore": false,
          "gameDifficulty": 1, // Difficulty: 1 easy
          "defaultSpawnBlockPosition": { "x": 0, "y": 100, "z": 0 },
          "achievementsDisabled": true,
          "editorWorldType": 0,
          "isCreatedInEditor": false,
          "isExportedFromEditor": false,
          "editorLevelMigrationVersion": 0, // EditorLevelMigrationVersion: 0 legacy
          "dayCycleStopTime": 0,
          "educationEditionOffer": 0,
          "educationFeaturesEnabled": false,
          "educationProductId": "",
          "rainLevel": 0,
          "lightningLevel": 0,
          "hasConfirmedPlatformLockedContent": false,
          "multiplayerGameIntent": true,
          "lanBroadcastIntent": true,
          "xboxLiveBroadcastSetting": 0,
          "platformBroadcastSetting": 0,
          "commandsEnabled": false,
          "texturePacksRequired": false,
          "ruleData": { "rulesList": [] },
          "experiments": { "toggles": [], "experimentsEverToggled": false },
          "hasBonusChestEnabled": false,
          "startWithMapEnabled": false,
          "playerPermissions": 1, // PlayerPermissionLevel: 1 member
          "serverChunkTickRange": 4,
          "hasLockedBehaviorPack": false,
          "hasLockedResourcePack": false,
          "isFromLockedTemplate": false,
          "useMsaGamertagsOnly": false,
          "isFromWorldTemplate": false,
          "isWorldTemplateOptionLocked": false,
          "onlySpawnV1Villagers": false,
          "personaDisabled": false,
          "customSkinsDisabled": false,
          "emoteChatMuted": false,
          "baseGameVersion": "*",
          "limitedWorldWidth": 0,
          "limitedWorldDepth": 0,
          "netherType": true, // new nether
          "eduSharedUriResource": { "buttonName": "", "linkUri": "" },
          "overrideForceExperimentalGameplay": null,
          "chatRestrictionLevel": 0,
          "disablePlayerInteractions": false,
          "serverEditorConnectionPolicy": 0,
          "allowAnonymousBlockDropsInEditorWorlds": false,
        } }, // level settings
        { "String": "" }, // level id
        { "String": "$worldName" }, // level name
        { "String": "" }, // template content identity
        { "Bool": false }, // trial
        { "SyncedPlayerMovementSettings": { "rewindHistorySize": 0, "serverAuthoritativeBlockBreaking": false } }, // movement settings
        { "UInt64LE": 0 }, // level current time
        { "VarInt32": 0 }, // enchantment seed
        { "Array<ServerBlockProperty>": [] }, // custom block properties
        { "String": "$uuid.random" }, // multiplayer correlation id
        { "Bool": true }, // server authoritative inventory
        { "String": "*" }, // server version
        { "NetworkNbt": { "compound": { } } }, // player property data: empty
        { "UInt64LE": 0 }, // server block type registry checksum
        { "UUID": { "mostSignificantBits": 0, "leastSignificantBits": 0 } }, // world template id
        { "Bool": false }, // client side generation
        { "Bool": false }, // block network ids are hashes
        { "NetworkPermissions": { "serverAuthSoundEnabled": false } }, // network permissions
        { "ServerConfig": null, "optional": true }, // server configuration join info: absent
        { "ServerTelemetryData": { "serverId": "", "scenarioId": "", "worldId": "", "ownerId": "" } }, // server telemetry data
      ],
    },
    // No items.
    "ItemRegistry": {
      "id": 162,
      "body": [
        { "Array<ItemData>": [] }, // item data
      ],
    },
    "ChunkRadiusUpdated": {
      "id": 70,
      "body": [
        { "VarInt32": "$radius" }, // chunk radius: the client's request, clamped
      ],
    },
    // No groups, no items.
    "CreativeContent": {
      "id": 145,
      "body": [
        { "Array<CreativeGroupInfo>": [] }, // groups
        { "Array<CreativeItemEntry>": [] }, // entries
      ],
    },
    "Transfer": {
      "id": 85,
      "body": [
        { "String": "$target.host" }, // server address
        { "UInt16LE": "$target.port" }, // server port
        { "Bool": false, "since": 729 }, // reload world
        { "GatheringsConfig": null, "since": 2168, "optional": true }, // gatherings configuration: absent
        { "TransferPlayerUIOptions": null, "since": 2250, "optional": true }, // server transfer settings: absent
      ],
    },
    // Sent instead of Transfer when the destination is offline.
    "Disconnect": {
      "id": 5,
      "body": [
        { "VarInt32": 0, "since": 622 }, // reason: 0 unknown
        { "Bool": false }, // skip message: false, so the messages follow
        { "DisconnectPacketMessages": { "message": "$offlineMessage", "filteredMessage": "$offlineMessage" } }, // messages
      ],
    },
  },

  "session": {
    "start": "awaitNetworkSettingsRequest",
    "transferPacket": "Transfer",
    "offlinePacket": "Disconnect",
    "compressionHeaderSince": 649,

    "stages": {
      // RequestNetworkSettings: the client's protocol. Reply uncompressed, then compress everything after.
      "awaitNetworkSettingsRequest": {
        "expect": { "packet": 193, "read": [ { "Int32BE": "$protocol" } ] },
        "steps": [
          { "send": [ "NetworkSettings" ], "compression": true, "goto": "awaitLogin" },
        ],
      },

      // Login. Older clients (before RequestNetworkSettings) report their protocol here first.
      "awaitLogin": {
        "expect": { "packet": 1, "read": [ { "Int32BE": "$protocol", "keep": true } ] },
        "steps": [
          { "send": [ "PlayStatusLoginSuccess" ] },
          // No resource pack stage for Immediate, or for clients older than 1.21.30 (729).
          { "if": { "any": [ { "timing": "Immediate" }, { "protocol": { "max": 728 } } ] }, "transfer": true },
          { "send": [ "ResourcePacksInfo" ], "goto": "awaitPacksResponse" },
        ],
      },

      // ResourcePackClientResponse: 1 Cancel, 2 Downloading, 3 DownloadingFinished, 4 ResourcePackStackFinished.
      // No packs are offered, so any of the first three moves on to the stack: 3 (has everything), 1 (declined;
      // packs aren't required) or 2 (asking to download, which 1.26.60 clients do even with no packs listed:
      // there's nothing to send, so the stack follows).
      "awaitPacksResponse": {
        "expect": { "packet": 8, "read": [ { "Byte": [1, 2, 3] } ] },
        "steps": [
          { "send": [ "ResourcePackStack" ], "goto": "awaitStackResponse" },
        ],
      },

      // ...then 4 once it has applied the stack. A client that was still "downloading" when the stack arrived
      // (2 first, then 3 once it found there was nothing to download) ignores that stack and answers again:
      // send it once more.
      "awaitStackResponse": {
        "expect": { "packet": 8, "read": [ { "Byte": "$packStatus" } ] },
        "steps": [
          { "if": { "variable": { "$packStatus": [1, 2, 3] } }, "log": "client answered the stack with another pack response; sending the stack once more.", "send": [ "ResourcePackStack" ], "goto": "awaitStackRetryResponse" },
          // Anything else but 4 (ResourcePackStackFinished): keep waiting.
          { "if": { "not": { "variable": { "$packStatus": 4 } } }, "goto": "awaitStackResponse" },
          // 1.26.60+ clients (2207+) ignore a Transfer sent during login: start a minimal empty game first.
          { "if": { "all": [ { "timing": "AfterSpawn" }, { "protocol": { "min": 2207 } } ] }, "log": "starting temporary game.", "send": [ "JigsawStructureData", "VoxelShapes", "StartGame", "ItemRegistry" ], "goto": "awaitChunkRadiusRequest" },
          { "transfer": true },
        ],
      },

      // The client answered the resent stack with another pack response too. Don't loop (some clients answer
      // every stack with 3): carry on as if it had applied it.
      "awaitStackRetryResponse": {
        "expect": { "packet": 8, "read": [ { "Byte": "$packStatus" } ] },
        "steps": [
          { "if": { "not": { "variable": { "$packStatus": [1, 2, 3, 4] } } }, "goto": "awaitStackRetryResponse" },
          { "if": { "variable": { "$packStatus": [1, 2, 3] } }, "log": "client answered the stack with another pack response again; continuing as if it applied it." },
          // 1.26.60+ clients (2207+) ignore a Transfer sent during login: start a minimal empty game first.
          { "if": { "all": [ { "timing": "AfterSpawn" }, { "protocol": { "min": 2207 } } ] }, "log": "starting temporary game.", "send": [ "JigsawStructureData", "VoxelShapes", "StartGame", "ItemRegistry" ], "goto": "awaitChunkRadiusRequest" },
          { "transfer": true },
        ],
      },

      // RequestChunkRadius: answer with the radius it asked for (clamped), spawn it, and send an empty creative inventory.
      "awaitChunkRadiusRequest": {
        "expect": { "packet": 69, "read": [ { "VarInt32": "$radius", "clamp": [1, 8] } ] },
        "steps": [
          { "send": [ "ChunkRadiusUpdated", "PlayStatusPlayerSpawn", "CreativeContent" ], "goto": "awaitSpawned" },
        ],
      },

      // SetLocalPlayerAsInitialized: the client has spawned. Transfer anyway if it doesn't say so in time.
      "awaitSpawned": {
        "expect": { "packet": 113 },
        "steps": [
          { "log": "client spawned.", "transfer": true },
        ],
        "timeout": {
          "seconds": "$spawnTimeout",
          "steps": [
            { "log": "no spawn confirmation in time; transferring anyway.", "transfer": true },
          ],
        },
      },

    },
  },
}
