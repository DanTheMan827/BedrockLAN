<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>BedrockLan.WebRtc</RootNamespace>
    <Description>Optional minimal NetherNet (WebRTC) server for BedrockLan that issues a Transfer packet. Uses SIPSorcery.</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DanTheMan827/BedrockLAN</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DanTheMan827/BedrockLAN.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BedrockLan\BedrockLan.csproj" />
  </ItemGroup>

</Project>
